# ─────────────────────────────────────────────────────────────────────────────
# SellerPilot configuration. Copy to .env.local and fill in what you have.
# With nothing filled in, the app runs fully offline: mock PayPal + rule-based agent.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── PayPal (sandbox) ─────────────────────────────────────────────────────────
# "mock" = in-memory PayPal simulator (default when the client id/secret are empty)
# "sandbox" = real calls to https://api-m.sandbox.paypal.com
PAYPAL_MODE=mock
# developer.paypal.com → Apps & Credentials → (Sandbox) your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional override; defaults to the sandbox base URL. Live is intentionally not supported.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id shown after adding a webhook under the app (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
# Email of the US *sandbox business* account the app belongs to (shown as the invoicer)
PAYPAL_INVOICER_EMAIL=
# Business name printed on invoices
SELLER_BUSINESS_NAME=SellerPilot Demo Studio

# ── LLM provider ─────────────────────────────────────────────────────────────
# gemini | groq | offline  (offline = deterministic rule-based parser, no key needed)
LLM_PROVIDER=offline
# Google AI Studio key (free tier, no billing) → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq key (free plan) → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Guardrails (USD) ─────────────────────────────────────────────────────────
# Invoices / checkout links above this need human approval before they go out
APPROVAL_THRESHOLD_USD=150
# Refunds above this need human approval
REFUND_AUTO_LIMIT_USD=50
# First-ever contact with a new customer needs approval (true/false)
APPROVE_FIRST_CONTACT=true

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used for PayPal return/cancel URLs). Local default shown.
APP_BASE_URL=http://localhost:3000
# SQLite file for app state (approvals, audit log, webhook idempotency, cache)
SELLERPILOT_DB=./data/sellerpilot.db
# Shared secret for POST /api/cron/collections (collections agent tick)
CRON_SECRET=change-me
# Seed demo records into an empty database on boot (mock mode only)
SEED_DEMO_DATA=true

# ── AG Studio (later milestone, start the 45-day trial on/after ~Nov 1) ──────
AG_STUDIO_LICENSE_KEY=
